+        try
+        {
+            Directory.CreateDirectory(staging);
+            WriteDurable(Path.Combine(staging, "report.json"), JsonSerializer.Serialize(snapshot, JsonOptions));
+            WriteDurable(Path.Combine(staging, "report.html"), BuildScanHtml(snapshot));

<?xml version="1.0" encoding="utf-8"?>
<policyDefinitions revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="gpc" namespace="G.PcHealthCheck.Policies" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <categories>
    <category name="GPCHealthCheck" displayName="$(string.Category.GPCHealthCheck)" />
    <category name="GPCHealthCheckSecurity" displayName="$(string.Category.SecurityPosture)">
      <parentCategory ref="GPCHealthCheck" />
    </category>
  </categories>
  <policies>
    <policy name="AllowedLocalAdministrators"
            class="Machine"
            displayName="$(string.Policy.AllowedLocalAdministrators)"
            explainText="$(string.Policy.AllowedLocalAdministrators.Help)"
            presentation="$(presentation.Policy.AllowedLocalAdministrators.Presentation)"
            key="SOFTWARE\Policies\GPCHealthCheck">
      <parentCategory ref="GPCHealthCheckSecurity" />
      <elements>
        <multiText id="AllowedLocalAdministratorsList"
                   valueName="AllowedLocalAdministrators" />
      </elements>
    </policy>
  </policies>
</policyDefinitions>
